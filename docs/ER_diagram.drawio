<mxfile host="app.diagrams.net"><diagram name="Conceptual ER diagram" id="d1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1200"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n3" value="&lt;b&gt;Farms&lt;/b&gt;&lt;hr&gt;&lt;u&gt;&lt;b&gt;farm_id&lt;/b&gt;&lt;/u&gt;&lt;br&gt;farm_name&lt;br&gt;emirate&lt;br&gt;area_hectares&lt;br&gt;is_active" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#e8f3e8;strokeColor=#2f6f3e;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="250" height="130" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Users&lt;/b&gt;&lt;hr&gt;&lt;u&gt;&lt;b&gt;user_id&lt;/b&gt;&lt;/u&gt;&lt;br&gt;username&lt;br&gt;password_hash&lt;br&gt;role&lt;br&gt;is_active" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#e8f3e8;strokeColor=#2f6f3e;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="250" height="130" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Markets&lt;/b&gt;&lt;hr&gt;&lt;u&gt;&lt;b&gt;market_id&lt;/b&gt;&lt;/u&gt;&lt;br&gt;market_name&lt;br&gt;emirate&lt;br&gt;is_active" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#e8f3e8;strokeColor=#2f6f3e;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="250" height="110" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Crops&lt;/b&gt;&lt;hr&gt;&lt;u&gt;&lt;b&gt;crop_id&lt;/b&gt;&lt;/u&gt;&lt;br&gt;crop_name&lt;br&gt;category&lt;br&gt;is_active" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#e8f3e8;strokeColor=#2f6f3e;" vertex="1" parent="1"><mxGeometry x="440" y="40" width="250" height="110" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;CropCycles&lt;/b&gt;&lt;hr&gt;&lt;u&gt;&lt;b&gt;cycle_id&lt;/b&gt;&lt;/u&gt;&lt;br&gt;planting_date&lt;br&gt;expected_harvest (FORECAST)&lt;br&gt;expected_quantity + unit&lt;br&gt;status" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#e8f3e8;strokeColor=#2f6f3e;" vertex="1" parent="1"><mxGeometry x="440" y="230" width="250" height="130" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;HarvestLots&lt;/b&gt;&lt;hr&gt;&lt;u&gt;&lt;b&gt;lot_id&lt;/b&gt;&lt;/u&gt;&lt;br&gt;quantity + unit&lt;br&gt;harvest_date&lt;br&gt;sell_by_date (optional)&lt;br&gt;is_active" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#e8f3e8;strokeColor=#2f6f3e;" vertex="1" parent="1"><mxGeometry x="440" y="450" width="250" height="130" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;HarvestLotImages&lt;/b&gt;&lt;hr&gt;&lt;u&gt;&lt;b&gt;image_id&lt;/b&gt;&lt;/u&gt;&lt;br&gt;file_path&lt;br&gt;mime_type (JPG/PNG)&lt;br&gt;caption" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#e8f3e8;strokeColor=#2f6f3e;" vertex="1" parent="1"><mxGeometry x="840" y="270" width="250" height="110" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;StockMovements&lt;/b&gt;&lt;hr&gt;&lt;u&gt;&lt;b&gt;movement_id&lt;/b&gt;&lt;/u&gt;&lt;br&gt;movement_type&lt;br&gt;quantity + unit&lt;br&gt;movement_date&lt;br&gt;reason" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#e8f3e8;strokeColor=#2f6f3e;" vertex="1" parent="1"><mxGeometry x="840" y="40" width="250" height="130" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Allocations&lt;/b&gt;&lt;hr&gt;&lt;u&gt;&lt;b&gt;allocation_id&lt;/b&gt;&lt;/u&gt;&lt;br&gt;quantity + unit&lt;br&gt;status&lt;br&gt;allocated_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#e8f3e8;strokeColor=#2f6f3e;" vertex="1" parent="1"><mxGeometry x="840" y="500" width="250" height="110" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;MarketRequests&lt;/b&gt;&lt;hr&gt;&lt;u&gt;&lt;b&gt;request_id&lt;/b&