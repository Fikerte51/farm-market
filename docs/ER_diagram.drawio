 id="c32" value="1" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#B0452F;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="6093" y="2208" width="44" height="30" as="geometry"/></mxCell><mxCell id="c33" value="N" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#B0452F;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="5454" y="2248" width="44" height="30" as="geometry"/></mxCell><mxCell id="c34" value="1" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#B0452F;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="3356" y="1449" width="44" height="30" as="geometry"/></mxCell><mxCell id="c35" value="N" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#B0452F;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="5077" y="2143" width="44" height="30" as="geometry"/></mxCell><mxCell id="c36" value="1" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#B0452F;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="3299" y="4573" width="44" height="30" as="geometry"/></mxCell><mxCell id="c37" value="N" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#B0452F;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="5138" y="2297" width="44" height="30" as="geometry"/></mxCell><mxCell id="c38" value="1" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#B0452F;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="5202" y="2320" width="44" height="30" as="geometry"/></mxCell><mxCell id="c39" value="N" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#B0452F;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="5242" y="3342" width="44" height="30" as="geometry"/></mxCell><mxCell id="c40" value="1" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#B0452F;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="3358" y="4554" width="44" height="30" as="geometry"/></mxCell><mxCell id="c41" value="N" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#B0452F;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="5116" y="3524" width="44" height="30" as="geometry"/></mxCell><mxCell id="c42" value="1" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#B0452F;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="3606" y="2318" width="44" height="30" as="geometry"/></mxCell><mxCell id="c43" value="N" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#B0452F;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="3215" y="2959" width="44" height="30" as="geometry"/></mxCell><mxCell id="c44" value="1" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#B0452F;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="2713" y="2324" width="44" height="30" as="geometry"/></mxCell><mxCell id="c45" value="N" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#B0452F;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="3108" y="2936" width="44" height="30" as="geometry"/></mxCell><mxCell id="c46" value="1" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#B0452F;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="3120" y="1458" width="44" height="30" as="geometry"/></mxCell><mxCell id="c47" value="N" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#B0452F;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="3160" y="2939" width="44" height="30" as="geometry"/></mxCell><mxCell id="c48" value="1" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#B0452F;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="3050" y="4551" width="44" height="30" as="geometry"/></mxCell><mxCell id="c49" value="N" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#B0452F;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="3114" y="3124" width="44" height="30" as="geometry"/></mxCell><mxCell id="c50" value="1" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#B0452F;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="6306" y="2320" width="44" height="30" as="geometry"/></mxCell><mxCell id="c51" value="N" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#B0452F;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="3470" y="4662" width="44" height="30" as="geometry"/></mxCell><mxCell id="c52" value="N" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#B0452F;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="533" y="2320" width="44" height="30" as="geometry"/></mxCell><mxCell id="c53" value="M" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#B0452F;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="2810" y="4622" width="44" height="30" as="geometry"/></mxCell><mxCell id="note0" value="&lt;b&gt;Key business rules&lt;/b&gt;&lt;br&gt;1. Expected harvest (crop_cycles.expected_quantity) is a forecast,&lt;br&gt;    never counted as stock.&lt;br&gt;2. on_hand / reserved / available are DERIVED from dated&lt;br&gt;    stock_movements (append-only ledger) - never stored.&lt;br&gt;3. An allocation cannot exceed the lot&#x27;s available quantity.&lt;br&gt;4. A market request can be filled by many allocations&lt;br&gt;    (partial fulfilment).&lt;br&gt;5. A delivery receipt stores received_quantity;&lt;br&gt;    discrepancy = received - allocated, reason required.&lt;br&gt;6. Every quantity is measured in a unit; units are converted&lt;br&gt;    only through to_base_factor.&lt;br&gt;7. Farmers act only on farms assigned to them; buyers only on&lt;br&gt;    their own market&#x27;s requests and receipts.&lt;br&gt;8. Every movement, status change, allocation, receipt and&lt;br&gt;    image records the responsible user." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FAFAF7;strokeColor=#9CA3AF;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="5460" y="215" width="1350" height="645" as="geometry"/></mxCell><mxCell id="note1" value="&lt;b&gt;Notation (Chen)&lt;/b&gt;&lt;br&gt;Rectangle = entity      Diamond = relationship      Oval = attribute&lt;br&gt;Underlined = primary key      Dashed red oval = derived (not stored)&lt;br&gt;Blue oval with sub-ovals = composite attribute&lt;br&gt;1 / N / M beside an entity = cardinality ratio (1:1, 1:N, M:N).&lt;br&gt;Double line = total (mandatory) participation; single line = partial&lt;br&gt;(optional). &#x27;assigned to&#x27; is M:N  -&gt;  table user_farms(user_id, farm_id).&lt;br&gt;A small hop marks two lines crossing (never a junction)." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FAFAF7;strokeColor=#9CA3AF;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="126" y="215" width="1230" height="322" as="geometry"/></mxCell><mxCell id="title" value="ER diagram - Local Farm &amp; Market Food Availability System" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#1F3D2B;align=left;" vertex="1" parent="1"><mxGeometry x="110" y="40" width="1600" height="40" as="geometry"/></mxCell><mxCell id="sub" value="Chen notation. Entities, attributes and the 28 relationships are generated from the farm_market database itself; attribute names are the column names in the relational schema." style="text;html=1;fontSize=13;fontColor=#4B5563;align=left;" vertex="1" parent="1"><mxGeometry x="110" y="92" width="2400" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>