ve="1" as="geometry"/></mxCell><mxCell id="n37" value="N" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="n11" target="n35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n38" value="confirmed by" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4cc;strokeColor=#b58900;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1110" y="530" width="110" height="50" as="geometry"/></mxCell><mxCell id="n39" value="1" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="n11" target="n38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n40" value="1" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="n13" target="n38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n41" value="places" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4cc;strokeColor=#b58900;fontSize=10;" vertex="1" parent="1"><mxGeometry x="510" y="705" width="110" height="50" as="geometry"/></mxCell><mxCell id="n42" value="1" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="n5" target="n41"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n43" value="N" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="n12" target="n41"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n44" value="history" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4cc;strokeColor=#b58900;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1110" y="760" width="110" height="50" as="geometry"/></mxCell><mxCell id="n45" value="1" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="n12" target="n44"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n46" value="N" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="n14" target="n44"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n47" value="assigned to" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4cc;strokeColor=#b58900;fontSize=10;" vertex="1" parent="1"><mxGeometry x="110" y="225" width="110" height="50" as="geometry"/></mxCell><mxCell id="n48" value="M" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="n4" target="n47"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n49" value="N" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="n3" target="n47"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n50" value="employs buyer" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4cc;strokeColor=#b58900;fontSize=10;" vertex="1" parent="1"><mxGeometry x="110" y="510" width="110" height="50" as="geometry"/></mxCell><mxCell id="n51" value="1" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="n5" target="n50"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n52" value="N" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="n4" target="n50"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n53" value="performs" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4cc;strokeColor=#b58900;fontSize=10;" vertex="1" parent="1"><mxGeometry x="310" y="600" width="110" height="50" as="geometry"/></mxCell><mxCell id="n54" value="1" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="n4" target="n53"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n55" value="N" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="n15" target="n53"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n56" value="&lt;b&gt;Business rules shown in the model:&lt;/b&gt;&lt;br&gt;1. Stock is never stored: current availability = sum of dated StockMovements.&lt;br&gt;2. Expected harvest (CropCycles) is a forecast, kept apart from saleable stock.&lt;br&gt;3. An allocation can never exceed the lot's available quantity; reserved stock is unavailable to others.&lt;br&gt;4. A receipt may differ from the allocation; the discrepancy and reason are stored.&lt;br&gt;5. Every quantity has a unit; conversion only through Units.to_base_factor.&lt;br&gt;6. Farm users change only assigned farms; buyers only their own market's requests; admins keep reference data.&lt;br&gt;7. Movements and status changes keep date, user and reason. Records are deactivated, not deleted." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#999999;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="1450" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>