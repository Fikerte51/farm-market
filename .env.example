# Copy this file to ".env" and fill in your own values. Never share or commit .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=farm_market

# Google Gemini key for the LangChain assistant (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash
